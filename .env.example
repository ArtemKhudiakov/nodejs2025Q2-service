# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/home_library?schema=public

# Application Configuration
PORT=4000
NODE_ENV=production

# PostgreSQL Configuration (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_library

# Logging Configuration
LOG_LEVEL=log
MAX_LOG_FILE_SIZE_KB=10240

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_ACCESS_EXPIRATION=10m

# JWT Refresh Token Configuration
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d
